{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "OneSTools.Ras": "Debug"
    }
  },
  "ClickHouse": {
    "ConnectionString": "Host=clickhouse;Port=8123;Username=default;Password=clickhouse;",
    "DatabasePrefix": "ras_",
    "DatabaseTemplate": "ras_cluster_{ClusterName}",
    "AutoCreateDatabases": true,
    "AutoCreateTables": true,
    "BatchSize": 10000,
    "FlushIntervalSeconds": 5,
    "WritingMaxDegreeOfParallelism": 1
  },
  "RasExporter": {
    "Servers": [
      {
        "Name": "mock-ras",
        "Host": "mock-ras",
        "Port": 1545,
        "ConnectTimeoutMilliseconds": 5000,
        "AgentAuth": {
          "User": "",
          "Password": ""
        },
        "PollIntervals": {
          "ClustersSeconds": 300,
          "ProcessesSeconds": 5,
          "SessionsSeconds": 5,
          "ConnectionsSeconds": 10,
          "LocksSeconds": 5
        },
        "Clusters": [
          {
            "ClusterId": "00000000-0000-0000-0000-000000000000",
            "ClusterName": "MainCluster",
            "User": "admin",
            "Password": "",
            "Enabled": true
          }
        ]
      }
    ]
  }
}