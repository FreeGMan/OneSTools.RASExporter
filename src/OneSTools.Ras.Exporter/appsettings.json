{
  "Logging": {
    "Console": {
      "FormatterName": "onestools",
      "onestools": {
        "TimestampFormat": "dd.MM.yyyy HH:mm:ss",
        "UseUtcTimestamp": false
      }
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "OneSTools.Ras": "Debug"
    }
  },
  "ClickHouse": {
    "ConnectionString": "Host=clickhouse;Port=8123;Username=default;",
    "DatabaseTemplate": "ras_cluster_{ClusterName}",
    "AutoCreateDatabases": true,
    "AutoCreateTables": true,
    "BatchSize": 10000,
    "FlushIntervalSeconds": 5
  },
  "RasExporter": {
    "Servers": [
      {
        "Name": "1c-test-server",
        "Host": "1c-test-server",
        "Port": 1545,
        "ConnectTimeoutMilliseconds": 5000,
        "AgentAuth": {
          "User": "",
          "Password": ""
        },
        "PollIntervals": {
          "ClustersSeconds": 300,
          "ProcessesSeconds": 5,
          "SessionsSeconds": 5,
          "ConnectionsSeconds": 10,
          "LocksSeconds": 5
        },
        "Clusters": [
          {
            "ClusterId": "23f2e521-fdc6-440a-98c3-85ca71b89158",
            "ClusterName": "LocalCluster",
            "User": "",
            "Password": "",
            "Enabled": true
          }
        ]
      }
    ]
  }
}
