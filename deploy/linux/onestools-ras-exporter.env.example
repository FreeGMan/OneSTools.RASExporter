# Переменные окружения службы onestools-ras-exporter.
# Копировать в /etc/onestools/ras-exporter/onestools-ras-exporter.env
# Права: chown root:rasexporter, chmod 0640 (сервис читает группу, запись — только root).
# Двойное подчёркивание = вложенность секций конфига; env имеет приоритет над appsettings*.json.
# ВНИМАНИЕ: юнит подключает файл с «EnvironmentFile=-», то есть отсутствующий файл молча
# игнорируется. Проверка после включения: systemctl show -p EnvironmentFiles <unit>.
# appsettings.json ищется в каталоге бинарника (bin/), а не в корне релиза.

# Строка подключения ClickHouse задаётся ЦЕЛИКОМ здесь (секрет не должен попадать в git).
ClickHouse__ConnectionString=Host=REPLACE-clickhouse;Port=8123;Username=ras_exporter;Password=REPLACE

# Точка входа RAS (порт 1545, протокол SWP — без TLS, только изолированный контур).
RasExporter__Servers__0__Name=ras-prod-1
RasExporter__Servers__0__Host=REPLACE-ras-host
RasExporter__Servers__0__Port=1545

# Учётные данные администратора агента RAS (пустые — анонимный вход, если на кластере
# не включена авторизация администратора).
RasExporter__Servers__0__AgentAuth__User=
RasExporter__Servers__0__AgentAuth__Password=

# Кластеры: пусто = автообнаружение всех кластеров сервера. НЕ задавайте пустые значения
# (RasExporter__Servers__0__Clusters__0__ClusterName=) — переменная создаёт элемент списка
# и валидация падает. Для конкретного кластера:
# RasExporter__Servers__0__Clusters__0__ClusterName=MainCluster
# (порождает одноимённую БД ras_cluster_maincluster) и, при авторизации администратора,
# RasExporter__Servers__0__Clusters__0__User / __Password.

# Громкость журнала (Debug включает wire-трассировку кадров — только для расследований).
Logging__LogLevel__OneSTools.Ras=Information
