{
  // Шаблон конфигурации для целевого сервера.
  // Скопировать рядом с бинарником как appsettings.json и заменить значения REPLACE_*.
  // Пароли сюда не писать: переопределение через переменные окружения (см. ras-exporter.env.example)
  // или файл appsettings.local.json рядом с бинарником (права только на сервис-аккаунт).
  // Приоритет: appsettings.json < appsettings.local.json < env < аргументы командной строки.
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "OneSTools.Ras": "Information"
    }
  },
  "ClickHouse": {
    // Password задаётся только в env/local-файле; env переопределяет строку подключения ЦЕЛИКОМ.
    "ConnectionString": "Host=REPLACE-clickhouse-host;Port=8123;Username=ras_exporter;",
    "DatabaseTemplate": "ras_cluster_{ClusterName}",
    "AutoCreateDatabases": true,
    "AutoCreateTables": true,
    "BatchSize": 10000,
    "FlushIntervalSeconds": 5
  },
  "RasExporter": {
    "Servers": [
      {
        "Name": "REPLACE-ras-1",
        "Host": "REPLACE-ras-host",
        "Port": 1545,
        "ConnectTimeoutMilliseconds": 5000,
        "AgentAuth": {
          "User": "",
          "Password": ""
        },
        "PollIntervals": {
          "ClustersSeconds": 300,
          "ProcessesSeconds": 5,
          "SessionsSeconds": 5,
          "ConnectionsSeconds": 10,
          "LocksSeconds": 5
        },
        // Пустой список — автообнаружение всех кластеров сервера.
        // Для уникальных имён БД на каждый кластер добавляйте {ClusterId} в DatabaseTemplate.
        "Clusters": []
      }
    ]
  }
}
